# Copy to .env and fill in. .env is git-ignored; never commit a real key.
GROQ_API_KEY=your_groq_api_key_here

# Optional overrides (defaults shown). Judge and benchmark models are kept
# separate so benchmark generation never competes with the production judge for quota.
# GROQ_JUDGE_MODEL=openai/gpt-oss-20b
# GROQ_ANSWER_MODEL=openai/gpt-oss-20b
# GROQ_BENCHMARK_MODEL=openai/gpt-oss-120b
